# Loading data with header and without converting to factors from csv file.
ProductData <- read.csv("C:/Users/reino/OneDrive/Desktop/Portfolio2/posts/Datacamp-certification-analyst/product_sales.csv", header=TRUE, stringsAsFactors=FALSE)
# Taking a look at first rows of dataset
head(ProductData)
# Checking data types for the whole dataset.
str(ProductData)
# Counting rows in dataset
nrow(ProductData)
# Looking at unique values of the column sales_method (3 expected values).
unique(ProductData$sales_method)
# Changing differences found the between groups.
ProductData$sales_method[ProductData$sales_method == "email"] <- "Email"
ProductData$sales_method[ProductData$sales_method == "em + call"] <- "Email + Call"
# Checking week column. (expected values: 1-6)
unique(ProductData$week)
# counting unique customers (checking if some customers are measured multiple times)
n_distinct(ProductData$customer_id)
