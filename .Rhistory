#### Multiple reggressie analyse
```{r}
#### Multiple reggressie analyse
rosetta::regr(
Intentie ~
Attitude_Agg+
Gedragscontrole_Agg +
Norm_Agg,
collinearity = TRUE,
data=Clean_data_16_40
);
Model <- lm(Intentie ~ Attitude_Agg+ Norm_Agg + Gedragscontrole_Agg, Clean_data_16_40)
plot(Model)
plot(Model, 4)
library(ggfortify)
autoplot(Model)
ggplot(Clean_data_16_40, aes(Intentie, Attitude_Agg)) +
